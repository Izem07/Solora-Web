# Server Port
PORT=3000

# ── SMB share credentials ────────────────────────────────────────────────────
# Username and password for the \\100.68.222.8\Music share.
# These are used by Docker to mount the Navidrome music folder into the container.
MUSIC_USER=
MUSIC_PASS=

# ── Navidrome settings ───────────────────────────────────────────────────────
# In the UI, set Music Directory to: /music  (the container-internal path)
NAVIDROME_DIR=/music

# Navidrome Subsonic API URL — used to trigger auto library scan after sync
NAVIDROME_URL=http://100.68.222.8:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_TOKEN=
NAVIDROME_SALT=
