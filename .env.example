# Server Port
PORT=3000

# Navidrome Local Storage Directory (where "Send to Navidrome" stores music)
# e.g., on Linux: /mnt/storage/music/Solora_Imports or on Windows: C:/Users/lionp/Music
NAVIDROME_DIR=./downloads

# Navidrome Subsonic API credentials for triggering auto-scan
# Base URL should include port (e.g., http://100.68.222.8:4533 or http://localhost:4533)
NAVIDROME_URL=http://100.68.222.8:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=
NAVIDROME_TOKEN=
NAVIDROME_SALT=
